# Copia este archivo a .env y rellena los valores.

SECRET_KEY=tu-clave-secreta-larga-y-aleatoria
DEBUG=True

# Si DEBUG=False, lista separada por comas (dominio del backend, sin https://)
ALLOWED_HOST=localhost,127.0.0.1

# Orígenes del front (con esquema), separados por comas. Obligatorio si el front está en otro dominio.
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Vacío = SQLite local. Con valor = PostgreSQL (Supabase).
# En Windows, la URL "directa" (db....supabase.co) suele ser solo IPv6 y puede dar getaddrinfo failed.
# Usa la URI de Session pooler (Connect → Session pooler): usuario postgres.TU_REF y host aws-0-TU_REGION.pooler.supabase.com
# DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Opcional: true/false. Si no pones nada, con DEBUG=False Django sirve /media/ en producción.
# SERVE_MEDIA_IN_PRODUCTION=auto
